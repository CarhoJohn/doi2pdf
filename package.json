{
  "name": "doi2pdf",
  "type": "module",
  "version": "0.1.5",
  "description": "More features for Zotero Local API",
  "config": {
    "addonName": "doi2pdf",
    "addonID": "doi2pdf@carhojohn.com",
    "addonRef": "doi2pdf",
    "addonInstance": "Doi2Pdf",
    "prefsPrefix": "extensions.zotero.doi2pdf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarhoJohn/doi2pdf.git"
  },
  "author": "CarhoJohn",
  "bugs": {
    "url": "https://github.com/CarhoJohn/doi2pdf/issues"
  },
  "homepage": "https://github.com/CarhoJohn/doi2pdf#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:unit": "node --test test/pdf.unit.test.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "mocha": "^11.7.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
